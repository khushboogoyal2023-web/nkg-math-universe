ate:{opacity:1,y:0},transition:{delay:.1},children:i.jsx(u7,{script:a.fullScript,title:a.title})})]}),i.jsx("button",{onClick:t,className:"w-full bg-card border-2 border-primary/30 hover:border-primary rounded-2xl py-4 font-heading text-primary transition-all",children:"← सभी पत्रवाचन विषयों पर वापस जाएं"})]})]})}const sy=[{no:1,type:"🎤 भाषण",title:"गणित का इतिहास और भारत का योगदान",level:"कक्षा 6-9",duration:"5-7 मिनट",color:"from-purple-500 to-indigo-600",intro:"यह भाषण भारत के गणितीय इतिहास पर केंद्रित है। इसमें बताएं कि गणित की नींव भारत में रखी गई थी।",points:['आरंभ: "नमस्ते! आज मैं आपको उस देश की गणितीय विरासत के बारे में बताऊंगा जहाँ हम रहते हैं..."',"शून्य की खोज: आर्यभट्ट और ब्रह्मगुप्त ने शून्य दिया। बिना शून्य के न कंप्यूटर होता, न मोबाइल।","दशमलव पद्धति: भारत ने 1,2,3...9,0 की पद्धति दी जो आज पूरी दुनिया उपयोग करती है।","आर्यभट्टीयम: 1500 साल पहले आर्यभट्ट ने π=3.1416 दिया — यह आज भी सटीक है!","बौधायन सूत्र: पाइथागोरस से 300 साल पहले भारत में यह सूत्र मिलता है।","रामानुजन: कोई औपचारिक शिक्षा नहीं, फिर भी 3900+ प्रमेय खोजे।",'अंत: "इस महान परंपरा को आगे बढ़ाना हम सबकी ज़िम्मेदारी है।"'],keyPoints:["शून्य की खोज","दशमलव पद्धति","आर्यभट्ट का π","रामानुजन की प्रतिभा"],doNot:["बहुत तेज़ मत बोलो","एक ही बात बार-बार मत दोहराओ","कागज़ देखते मत रहो"],sampleLines:'"प्राचीन काल में जब यूरोप अंधकार में था, भारत के गणितज्ञ तारों की गिनती कर रहे थे। आज जो अंक हम लिखते हैं, वे भारत की देन हैं।"'},{no:2,type:"📖 कविता",title:"पहाड़ों की कविता (गुणन तालिका)",level:"कक्षा 1-5",duration:"2-3 मिनट",color:"from-orange-500 to-red-500",intro:"यह कविता पहाड़ों (गुणन तालिकाओं) को याद करने के लिए है। लय और तुकबंदी से पहाड़े आसान हो जाते हैं।",points:["दो का पहाड़ा:",`"दो एकम दो, दो दूनी चार,
दो तीए छः, लगाओ विचार।
दो चौके आठ, दो पाँचे दस,
दो छक्के बारह, याद करो बस!"`,"","पाँच का पहाड़ा:",`"पाँच एकम पाँच, पाँच दूनी दस,
पाँच तीन पंद्रह, सीखो इसे बस।
पाँच चार बीस, पाँच पाँच पच्चीस,
पाँच छः तीस, इसे भूलो मत नहीं!"`,"","प्रस्तुति टिप्स: लय में बोलो, हाथ हिलाओ, सुनने वालों को साथ में दोहराने दो।"],keyPoints:["लय और ताल","तुकबंदी","सरल शब्द","दोहराव"],doNot:["बहुत धीरे मत बोलो","बिना भाव के मत पढ़ो","शब्द मत भूलो"],sampleLines:'"दो एकम दो, दो दूनी चार — पहाड़ा सीखो यार-यार!"'},{no:3,type:"🎭 नाटक",title:"रामानुजन — एक अलौकिक प्रतिभा",level:"कक्षा 7-9",duration:"10-15 मिनट",color:"from-teal-500 to-green-600",intro:"यह नाटक श्रीनिवास रामानुजन के जीवन पर आधारित है। 3-4 पात्र चाहिए।",points:["पात्र: रामानुजन, उनकी माँ, Hardy (Cambridge professor), एक मित्र","","दृश्य 1 — स्कूल (तमिलनाडु, 1900):",'रामानुजन: "Sir, 1+2+3+... को -1/12 माना जा सकता है!"','Teacher: "बकवास! यह असंभव है!"','मित्र: "रामानुजन, तुम हर समय इसी में लगे रहते हो!"','रामानुजन: "देवी नामगिरि मुझे सपने में सूत्र बताती हैं..."',"","दृश्य 2 — घर (1912):",'माँ: "बेटा, Cambridge से चिट्ठी आई है!"','रामानुजन: "Professor Hardy ने बुलाया है! पर माँ, समुद्र पार जाऊं?"',"","दृश्य 3 — Cambridge (1914):",'Hardy: "1729 — यह तो साधारण संख्या है!"','रामानुजन: "नहीं Sir! यह सबसे छोटी संख्या है जो दो तरह से दो घनों का योग है — 12³+1³ और 10³+9³!"','Hardy: "अविश्वसनीय! तुम्हारा दिमाग कैसे काम करता है?"',"",'अंत: रामानुजन का संदेश — "गणित में आनंद लो, डरो मत!"'],keyPoints:["रामानुजन की प्रतिभा","1729 का रहस्य","Hardy की मित्रता","देशप्रेम"],doNot:["रटे-रटाए मत लगो","भाव ज़रूरी है","संवाद छोटे रखो"],sampleLines:'"Hardy: तुम्हारी प्रतिभा ईश्वर की देन है। Raman: नहीं Sir, यह भारत की गणित परंपरा की देन है!"'},{no:4,type:"🎤 भाषण",title:"वैदिक गणित — क्यों और कैसे?",level:"कक्षा 5-9",duration:"5-8 मिनट",color:"from-amber-500 to-orange-500",intro:"वैदिक गणित की उपयोगिता और विधियों पर भाषण। आधुनिक शिक्षा में इसकी ज़रूरत क्यों है — यह बताएं।",points:['आरंभ: "क्या आप 98×97 का उत्तर 5 सेकंड में दे सकते हैं? वैदिक गणित से यह संभव है!"',"","1. वैदिक गणित क्या है?","   — स्वामी भारती कृष्ण तीर्थ द्वारा 1911-1918 में अथर्ववेद से निकाले 16 सूत्र।","   — ये सूत्र गणित की हर शाखा को सरल बनाते हैं।","","2. क्यों ज़रूरी है?","   — प्रतियोगिता परीक्षाओं (JEE, NEET, CAT) में समय बचाता है।","   — मानसिक गणना शक्ति बढ़ती है।","   — गणित का डर कम होता है।","","3. प्रदर्शन: (मंच पर गणना करके दिखाएं)","   98×97 = आधार 100, 98-3=95, 2×3=06 → 9506","   35² = 3×4=12, 25 → 1225","","4. भारत का गर्व:","   — यह भारतीय ज्ञान परंपरा का हिस्सा है।","   — आज विदेशों में भी पढ़ाया जाता है।","",'अंत: "आइए, हम अपनी प्राचीन विरासत को अपनाएं।"'],keyPoints:["16 सूत्र","तेज़ गणना","भारतीय परंपरा","प्रतियोगिता में उपयोग"],doNot:["बहुत ज़्यादा तकनीकी मत जाओ","उदाहरण दिए बिना मत छोड़ो"],sampleLines:'"जब आपका साथी कैलकुलेटर ढूंढ रहा हो, आप वैदिक गणित से पहले ही उत्तर दे चुके होंगे!"'},{no:5,type:"📖 निबंध",title:"गणित और प्रकृति — एक अटूट रिश्ता",level:"कक्षा 5-9",duration:"2 पेज",color:"from-green-500 to-teal-600",intro:"प्रकृति में गणित हर जगह है। यह निबंध उन अद्भुत उदाहरणों पर है जहाँ गणित प्रकृति में दिखता है।",points:['प्रस्तावना: "कहते हैं ईश्वर ने ब्रह्मांड की रचना गणित से की है।"',"","1. फिबोनाची श्रेणी:","   — गुलाब की 5, 8, या 13 पंखुड़ियाँ।","   — सूरजमुखी के बीज 34 और 55 सर्पिल में।","   — नॉटिलस शंख Golden Spiral बनाता है।","","2. स्वर्णिम अनुपात (Golden Ratio φ = 1.618):","   — मनुष्य के शरीर में नाभि से पाँव और सिर से नाभि का अनुपात ≈ 1.618।","   — Mona Lisa का चेहरा, Parthenon की रचना।","","3. ज्यामिति:","   — मधुमक्खी का षट्भुज — सबसे कम मोम, सबसे ज़्यादा जगह।","   — बर्फ के क्रिस्टल — 6-गुना सममिति।","   — कछुए का खोल — पंचभुज और षट्भुज।","","4. संख्याएं:","   — DNA की संरचना में गणितीय अनुपात।","   — ग्रहों की कक्षाएं — दीर्घवृत्त (Ellipse)।","",'निष्कर्ष: "प्रकृति गणित की भाषा बोलती है। गणित सीखना प्रकृति को समझना है।"'],keyPoints:["फिबोनाची","Golden Ratio","षट्भुज","सर्पिल"],doNot:["भटको मत","हर बिंदु को उदाहरण दो","निष्कर्ष ज़रूर लिखो"],sampleLines:'"प्रकृति पहले गणित जानती है, फिर सुंदरता रचती है।"'},{no:6,type:"🎭 नाटक",title:"शकुंतला देवी बनाम कंप्यूटर",level:"कक्षा 4-8",duration:"8-10 मिनट",color:"from-pink-500 to-rose-600",intro:"शकुंतला देवी की अद्भुत मानसिक गणना शक्ति पर नाटक। यह सत्य घटना पर आधारित है।",points:["पात्र: शकुंतला देवी, Reporter, Computer Operator, Audience members","","दृश्य 1 — Dallas University, 1977:",'Reporter: "आज हम एक चुनौती देंगे — Shakuntala Devi vs Computer!"','Operator: "Machine तैयार है।"','Reporter: "7,686,369,774,870 × 2,465,099,745,779 = ?"',"","दृश्य 2 — गणना:",'Operator: "(typing...) 30 seconds...) उत्तर आया!"','शकुंतला (28 सेकंड में): "18,947,668,177,995,426,462,773,730!"','Reporter: "Computer का उत्तर... same है! Shakuntala जीत गईं!"',"","दृश्य 3 — Interview:",'Reporter: "यह कैसे किया?"','शकुंतला: "बचपन में मेरे पिता खेलों में मेरी प्रतिभा देखते थे। मैंने कभी Calculator नहीं छुआ।"','"संख्याएं मुझे प्यार करती हैं और मैं उन्हें।"',"",'अंत: "आप भी अभ्यास से इस ऊंचाई तक पहुँच सकते हैं!"'],keyPoints:["मानसिक गणना","अभ्यास का महत्व","भारतीय गर्व","गिनीज़ रिकॉर्ड"],doNot:["Computer Operator को रोबोट जैसे बोलना","संख्याएं गलत मत बोलो"],sampleLines:'"Shakuntala: Numbers are my best friends. They never lie!"'},{no:7,type:"🎤 भाषण",title:"गणित का भय — कारण और समाधान",level:"कक्षा 5-9",duration:"5-7 मिनट",color:"from-blue-500 to-cyan-600",intro:'बहुत से बच्चे गणित से डरते हैं। यह भाषण "Math Anxiety" के कारण और उसे दूर करने के उपाय बताता है।',points:['आरंभ: "हाथ उठाओ — कितनों को गणित से डर लगता है?"','"आज हम इस डर को जड़ से मिटाएंगे!"',"","1. गणित का डर क्यों?",'   — "गणित कठिन है" — यह गलत धारणा।',"   — जल्दी-जल्दी सिखाया जाता है, समझ नहीं होती।","   — गलत होने का डर।","   — परीक्षा का दबाव।","","2. सच्चाई क्या है?","   — गणित तर्क है, रटना नहीं।","   — हर बच्चा गणित सीख सकता है।","   — रामानुजन गरीब थे, पर शानदार गणितज्ञ बने।","","3. समाधान:","   — रोज़ 15 मिनट अभ्यास।","   — पहले बुनियाद मज़बूत करो।","   — खेल से सीखो (Math games)।","   — वैदिक गणित की ट्रिक्स सीखो।","   — गलतियों से डरो मत।","",'अंत: "गणित डरावना नहीं, दिलचस्प है। बस एक कदम उठाओ!"'],keyPoints:["Math Anxiety","कारण और निदान","अभ्यास","आत्मविश्वास"],doNot:["श्रोताओं को शर्मिंदा मत करो","पॉजिटिव रखो"],sampleLines:'"Einstein कहते थे — Imagination is more important than knowledge. गणित में कल्पनाशक्ति ज़रूरी है!"'},{no:8,type:"📖 कविता",title:"ज्यामिति की दुनिया",level:"कक्षा 3-7",duration:"2-3 मिनट",color:"from-violet-500 to-purple-600",intro:"बिंदु, रेखा, कोण, त्रिभुज और वृत्त पर एक रंगीन कविता। चित्र बनाते हुए पढ़ें।",points:[`"बिंदु एक, स्थान दिखाए,
रेखा उससे दोनों तरफ जाए।
रेखाखंड के दो छोर,
किरण चले एक ओर।"`,"",`"तीन भुजाओं का मेल,
त्रिभुज है, खेलो खेल।
कोणों का योग है सौ-अस्सी,
पाइथागोरस की बात है पक्की।"`,"",`"वृत्त गोल, केंद्र एक,
त्रिज्या समान, चाप अनेक।
व्यास सबसे बड़ी जीवा,
π से मिलती इसकी दिशा।"`,"",`"वर्ग की चार भुजाएं समान,
आयत में भी समकोण महान।
षट्भुज मधुमक्खी का घर,
ज्यामिति है जीवन का स्वर।"`,"","प्रस्तुति: हर छंद के बाद बोर्ड पर वह आकृति बनाएं।"],keyPoints:["आकृतियाँ","सरल भाषा","चित्र-सहित","तुकबंदी"],doNot:["बहुत जल्दी मत पढ़ो","भाव लाओ"],sampleLines:'"ज्यामिति है जीवन का स्वर, हर आकृति में छुपा है एक जादू!"'},{no:9,type:"🎭 नाटक",title:"शून्य की खोज — ब्रह्मगुप्त और आर्यभट्ट",level:"कक्षा 6-9",duration:"10-12 मिनट",color:"from-indigo-500 to-blue-600",intro:"शून्य की खोज कैसे हुई — इस काल्पनिक-ऐतिहासिक नाटक में दिखाएं। शून्य के बिना गणित अधूरा था।",points:["पात्र: आर्यभट्ट (476 CE), ब्रह्मगुप्त (598 CE), शिष्य 1, शिष्य 2, एक व्यापारी","","दृश्य 1 — आर्यभट्ट का आश्रम:",'शिष्य: "गुरुजी, दस में से दस घटाएं तो?"','आर्यभट्ट: (सोचते हुए) "कुछ नहीं... शून्य! इसे भी एक संख्या माना जाए!"','शिष्य: "पर शून्य का स्थान कहाँ?"','आर्यभट्ट: "दहाई और इकाई के बीच — जैसे 10 में।"',"","दृश्य 2 — 100 साल बाद, ब्रह्मगुप्त:",'व्यापारी: "मुझे 50 रुपये उधार लेने हैं। मेरे पास शून्य है।"','ब्रह्मगुप्त: "तो उधार लेने पर: 0 - 50 = -50!"','शिष्य 2: "ऋणात्मक संख्या?!"','ब्रह्मगुप्त: "हाँ! शून्य + शून्य = शून्य, शून्य × कुछ भी = शून्य!"',"","दृश्य 3 — भविष्य (कल्पना):",'एक आधुनिक छात्र: "बिना शून्य के क्या होता?"','आर्यभट्ट: "10 नहीं, 100 नहीं, 1000000 नहीं। कंप्यूटर नहीं!"',"","अंत: शून्य के बिना आधुनिक सभ्यता असंभव थी।"],keyPoints:["शून्य का इतिहास","ऋणात्मक संख्याएं","भारत का योगदान"],doNot:["इतिहास गलत मत करो","संवाद सरल रखो"],sampleLines:'"आर्यभट्ट: शून्य एक संख्या है — सबसे शक्तिशाली! इसके बिना 10, 100, 1000 सब अधूरे हैं।"'},{no:10,type:"🎤 भाषण",title:"AI और गणित — भविष्य की भाषा",level:"कक्षा 7-9",duration:"6-8 मिनट",color:"from-cyan-500 to-sky-600",intro:"कृत्रिम बुद्धिमत्ता (AI), Machine Learning और आधुनिक तकनीक में गणित की भूमिका।",points:['आरंभ: "ChatGPT, Siri, Self-driving cars — इन सबके पीछे एक ही चीज़ है: गणित!"',"","1. AI क्या है?","   — कंप्यूटर जो सोच सके — Artificial Intelligence।","   — यह गणित के एल्गोरिदम से बनता है।","","2. गणित कहाँ लगता है?","   — Linear Algebra: Neural Networks में।",'   — Calculus: AI को "सीखाने" में।',"   — Statistics: डेटा समझने में।","   — Probability: निर्णय लेने में।","","3. रोज़मर्रा में AI गणित:","   — YouTube recommendations — Matrix multiplication।","   — Google Maps — Graph Theory + Dijkstra's Algorithm।","   — Face recognition — Geometry + Statistics।","","4. भविष्य:","   — जो बच्चे आज गणित सीखेंगे, वे कल AI बनाएंगे।","   — भारत AI Superpower बन रहा है।","",'अंत: "गणित की नींव मज़बूत करो — भविष्य तुम्हारा है!"'],keyPoints:["AI की परिभाषा","गणित का उपयोग","भारत का भविष्य","प्रेरणा"],doNot:["बहुत Technical मत जाओ","रोज़मर्रा के उदाहरण दो"],sampleLines:'"हर बार जब Google आपको सही रास्ता बताता है, एक गणितीय Algorithm काम कर रहा होता है!"'},{no:11,type:"📊 प्रस्तुति",title:"20वीं सदी की 10 बड़ी गणितीय खोजें",level:"कक्षा 8-9",duration:"8-10 मिनट",color:"from-fuchsia-500 to-pink-600",intro:"पिछले 100 सालों में गणित ने दुनिया बदल दी। इन 10 खोजों पर एक इंटरेक्टिव प्रस्तुति।",points:["1. Gödel's Incompleteness Theorem (1931): कोई भी गणितीय प्रणाली अपूर्ण होती है।","2. ENIAC — पहला कंप्यूटर (1945): Binary Math पर आधारित।","3. DNA की संरचना (1953): Double Helix — गणितीय Spiral।","4. RSA Encryption (1977): बड़ी अभाज्य संख्याओं पर बैंकिंग सुरक्षा।",'5. Chaos Theory (1963): छोटे बदलाव, बड़े परिणाम — "Butterfly Effect"।',"6. Fractal Geometry (1975): Mandelbrot Set — कंप्यूटर ग्राफ़िक्स की नींव।","7. Wiles का फेर्मा प्रमाण (1995): 358 साल की पहेली हल।","8. Perelman का Poincaré हल (2003): 100 साल पुरानी समस्या, पुरस्कार ठुकराया!","9. Machine Learning Math (2012): Deep Neural Networks।","10. ChatGPT का गणित (2022): Transformer Architecture — Matrix Math।","","प्रस्तुति: हर खोज के लिए एक स्लाइड या पोस्टर।"],keyPoints:["10 खोजें","सरल व्याख्या","आज से संबंध","उत्साह"],doNot:["बहुत गहरा जाने की ज़रूरत नहीं","रोचक तथ्य दो"],sampleLines:'"Perelman ने $1 million का पुरस्कार ठुकरा दिया! क्योंकि उनके लिए गणित पैसे से बड़ा था!"'},{no:12,type:"🎭 नाटक",title:"फेर्मा की पहेली — 358 साल का रहस्य",level:"कक्षा 8-9",duration:"12-15 मिनट",color:"from-amber-500 to-yellow-500",intro:"फेर्मा की अंतिम प्रमेय और Andrew Wiles की 7 साल की यात्रा पर नाटक।",points:["पात्र: फेर्मा (1637 CE), Andrew Wiles, Wiles की पत्नी, एक छात्र, Reporter","","दृश्य 1 — 1637, फ्रांस:",'फेर्मा (किताब में लिखते हुए): "aⁿ + bⁿ = cⁿ का कोई पूर्णांक हल नहीं जब n > 2।"','"मेरे पास इसका अद्भुत प्रमाण है, पर इस हाशिए में जगह नहीं!"',"(चले जाते हैं — रहस्य छोड़कर)","","दृश्य 2 — 1986, Oxford:",'Wiles (10 साल की उम्र की याद): "जब मैं 10 साल का था, यह प्रमेय पढ़ी थी।"','"मैं इसे ज़रूर हल करूंगा!"','पत्नी: "7 साल हो गए! खाना खाओ कम से कम!"','Wiles: "मुझे माफ़ करो, पर यह मेरा सपना है।"',"","दृश्य 3 — 1993, Cambridge:",'Reporter: "Dr. Wiles ने फेर्मा प्रमेय सिद्ध की! 358 साल बाद!"','Wiles (रो रहे हैं): "यह क्षण... मैं बयान नहीं कर सकता।"',"",'छात्र: "Sir, क्या सीखा?"','Wiles: "Never give up. गणित में हर सवाल का जवाब होता है।"'],keyPoints:["फेर्मा का रहस्य","Wiles की लगन","कभी हार न मानो","गणित की सुंदरता"],doNot:["Math details में ज़्यादा मत जाओ","भावनाएं ज़रूरी हैं"],sampleLines:'"Wiles: यह सिर्फ एक प्रमेय नहीं थी — यह 358 साल के गणितज्ञों का सपना था!"'},{no:13,type:"🎤 भाषण",title:"गणित और संगीत — सातों सुर में गणित",level:"कक्षा 5-8",duration:"5-6 मिनट",color:"from-lime-500 to-green-600",intro:"संगीत और गणित का गहरा रिश्ता है। सा, रे, ग, म, प, ध, नि — इनमें गणित छुपा है।",points:['आरंभ: एक सुर गाएं — "सा..." "क्या आप जानते हैं इस सुर में गणित है?"',"","1. तरंग और गणित:","   — हर सुर एक Frequency (Hz) है।","   — सा = 240 Hz, रे = 270 Hz, ग = 300 Hz...","   — अनुपात: 8:9:10:... = गणितीय Progression।","","2. पाइथागोरस और संगीत:","   — उन्होंने खोजा: दो तारों का अनुपात 2:1 हो → एक Octave।","   — 3:2 → Perfect Fifth (पंचम सुर)।","","3. ताल और गणित:","   — तीन ताल = 16 मात्राएं।","   — एकताल = 12 मात्राएं।","   — यह विभाज्यता और लय का गणित है।","","4. भारतीय संगीत:","   — 72 मेलकर्ता राग = 72 गणितीय संयोजन।","   — राग भैरवी, यमन, भीमपलासी — सब गणित पर!","",'अंत: "जब आप गाते हैं, आप गणित भी करते हैं!"'],keyPoints:["Frequency","अनुपात","ताल-मात्राएं","राग का गणित"],doNot:["बहुत Technical Physics मत करो","गाकर दिखाओ"],sampleLines:'"पाइथागोरस एक महान गणितज्ञ थे — वे एक महान संगीतकार भी थे!"'},{no:14,type:"📖 कविता",title:"अभाज्य संख्याओं का गीत",level:"कक्षा 4-7",duration:"3-4 मिनट",color:"from-sky-500 to-blue-600",intro:"2, 3, 5, 7, 11... इन खास संख्याओं की तुकबंदी वाली कविता।",points:[`"दो — पहली अभाज्य, सम भी है यही,
बाकी सब विषम, यह नियम नई।"`,"",`"तीन — छोटी, प्यारी, 1 और 3 से बटती,
तीन तीन में अंकों का योग मिलती।"`,"",`"पाँच — हर संख्या जो 5 या 0 पर खत्म,
पाँच से बटती, यह है गुण पूरब-पश्चिम।"`,"",`"सात — सबसे मज़ेदार, 7 का पहाड़ा अजीब,
7×8=56, याद करो, है यह नज़दीब।"`,"",`"ग्यारह — 11,13,17,19...
जुड़वाँ जोड़े Twin Primes, देखो इनकी लड़ी।"`,"",`"अभाज्य संख्याएं अनंत हैं,
यूक्लिड ने सिद्ध किया यह तथ्य।
इनसे बनता RSA Encryption,
तुम्हारा Bank password है सुरक्षित!"`,"","प्रस्तुति: हर संख्या को बोर्ड पर लिखते जाएं।"],keyPoints:["अभाज्य संख्याएं","Twin Primes","RSA","यूक्लिड"],doNot:["लय मत तोड़ो","उत्साह से पढ़ो"],sampleLines:'"2, 3, 5, 7 — अभाज्य की फौज, इनसे बटती दुनिया की खोज!"'},{no:15,type:"📊 प्रस्तुति",title:"क्रिप्टोग्राफी — गणित से सुरक्षा",level:"कक्षा 8-9",duration:"8-10 मिनट",color:"from-rose-500 to-pink-600",intro:"इंटरनेट, बैंकिंग और WhatsApp सुरक्षा — सब गणित पर। RSA Encryption की रोचक कहानी।",points:['आरंभ: "जब आप WhatsApp पर message करते हैं, वह Lock होता है। कैसे?"',"","1. Caesar Cipher (प्राचीन):","   — Julius Caesar: हर अक्षर को 3 आगे खिसकाओ।","   — A→D, B→E, C→F...","   — HELLO → KHOOR","","2. RSA Encryption:","   — 1977 में Rivest, Shamir, Adleman द्वारा।","   — दो बड़ी अभाज्य संख्याओं का गुणनफल।","   — p=17, q=11 → n=187 (Public Key)।","   — n को वापस 17×11 में तोड़ना कंप्यूटर के लिए भी कठिन!","","3. क्यों सुरक्षित?","   — 1000+ अंकों की अभाज्य संख्याएं।","   — उन्हें factor करना अरबों साल लेगा।","","4. भविष्य — Quantum Computers:","   — Quantum computer RSA तोड़ सकते हैं।","   — इसलिए Quantum Cryptography आ रही है।","",'अंत: "आपका Bank Password — गणित की अभाज्य संख्याओं की ताकत से सुरक्षित है!"'],keyPoints:["Caesar Cipher","RSA","अभाज्य संख्याएं","Quantum Computing"],doNot:["बहुत deep Computer Science मत जाओ","रोचक बनाओ"],sampleLines:'"अगर आप 2048-bit RSA key को factor करना चाहो, तो उम्र भर भी काफी नहीं!"'},{no:16,type:"🎭 नाटक",title:"आर्यभट्ट का जमाना — 500 CE",level:"कक्षा 5-8",duration:"10-12 मिनट",color:"from-orange-400 to-amber-500",intro:"आर्यभट्ट के समय की नाटकीय झांकी। उनकी खोजें और उनका जीवन।",points:["पात्र: आर्यभट्ट (23 वर्ष), राजा, शिष्य, एक पुजारी, खगोलशास्त्री","","दृश्य 1 — पाटलिपुत्र, 499 CE:",'शिष्य: "गुरुजी, पृथ्वी स्थिर है और सूरज घूमता है।"','आर्यभट्ट: "नहीं! पृथ्वी स्वयं घूमती है। इसीलिए सूरज उगता-डूबता दिखता है।"','पुजारी: "यह धर्म के विरुद्ध है!"','राजा: "सिद्ध करो!"',"","दृश्य 2 — खोज:",'आर्यभट्ट: "π = 62832/20000 = 3.1416। यह बहुत सटीक है!"','"365 दिन 6 घंटे 12 मिनट 30 सेकंड — एक सौर वर्ष!"','खगोलशास्त्री: "Modern calculation = 365 days 5 hours 48 min। Incredible!"',"","दृश्य 3 — भविष्यवाणी:",'आर्यभट्ट: "सूर्यग्रहण तब होता है जब चंद्रमा बीच में आता है।"','"यह देवताओं का काम नहीं — विज्ञान है!"',"",'अंत: "1500 साल बाद, भारत का उपग्रह आर्यभट्ट के नाम पर!"'],keyPoints:["आर्यभट्ट की खोजें","π का मान","पृथ्वी की गति","भारतीय गर्व"],doNot:["ऐतिहासिक तथ्य सही रखो","पोशाक उचित हो"],sampleLines:'"आर्यभट्ट: पृथ्वी घूमती है — यह सत्य है, चाहे कोई माने या न माने!"'},{no:17,type:"🎤 भाषण",title:"रोज़मर्रा की ज़िंदगी में गणित",level:"कक्षा 3-7",duration:"4-6 मिनट",color:"from-teal-400 to-cyan-500",intro:"गणित सिर्फ किताबों में नहीं, बाज़ार, रसोई, खेल, यात्रा हर जगह है। यह भाषण उन पर।",points:['आरंभ: "सुबह उठने से रात सोने तक — गणित!"',"","1. सुबह:","   — अलार्म = समय का गणित।","   — नाश्ता = मात्रा, अनुपात।","","2. बाज़ार:","   — 500 में से 437 गए → 63 बचे।","   — 20% discount → 100 का 80 रुपये।","   — EMI = Compound Interest का गणित।","","3. खेल:","   — Cricket का Strike Rate = (runs/balls)×100।","   — Football के कोण।","   — Chess = Probability + Strategy।","","4. रसोई:","   — 4 लोगों की दाल 5 लोगों के लिए = अनुपात।","   — तापमान, समय = भौतिकी + गणित।","","5. यात्रा:","   — Distance = Speed × Time।","   — GPS = Geometry + Trigonometry।","",'अंत: "गणित जीवन की भाषा है — इसे प्यार करो!"'],keyPoints:["व्यावहारिक उदाहरण","सरल भाषा","रोचक","जीवन से जोड़ो"],doNot:["Abstract बातें मत करो","छोटे बच्चों के लिए सरल रखो"],sampleLines:'"जब माँ कहती हैं — 4 लोगों की सब्ज़ी 5 के लिए बनाओ — वे गणित कर रही हैं!"'},{no:18,type:"📖 निबंध",title:"महिला गणितज्ञ — प्रेरणा की मिसाल",level:"कक्षा 6-9",duration:"2-3 पेज",color:"from-fuchsia-400 to-purple-500",intro:"इतिहास की महान महिला गणितज्ञों पर निबंध — जिन्होंने बाधाओं के बावजूद इतिहास बनाया।",points:['प्रस्तावना: "गणित की दुनिया पहले पुरुषों तक सीमित थी। पर कुछ महिलाओं ने इसे बदल दिया।"',"","1. हाइपेशिया (370-415 CE):","   — पहली प्रसिद्ध महिला गणितज्ञ।","   — Alexandria में ज्यामिति और खगोलशास्त्र पढ़ाती थीं।","","2. एडा लवलेस (1815-1852):","   — पहली कंप्यूटर प्रोग्रामर।","   — बैबेज की Machine के लिए Algorithm लिखा।",'   — "Ada" Programming Language उन्हीं के नाम पर।',"","3. सोफिया कोवालेव्स्काया (1850-1891):","   — रूस की पहली महिला Professor।","   — Partial Differential Equations में क्रांतिकारी काम।","","4. एम्मी नोएथर (1882-1935):",'   — Einstein उन्हें "सर्वकालिक महान महिला गणितज्ञ" कहते थे।',"   — Abstract Algebra की जननी।","","5. शकुंतला देवी (1929-2013):","   — Human Computer — Guinness Record।","   — भारत की गर्व।","","6. मरियम मिर्ज़ाखानी (1977-2017):","   — Fields Medal पाने वाली पहली महिला (2014)।","   — Riemann Surfaces पर क्रांतिकारी काम।","",'निष्कर्ष: "प्रतिभा का कोई लिंग नहीं होता। गणित सबके लिए है।"'],keyPoints:["6 महिलाएं","उनका योगदान","बाधाएं और जीत","प्रेरणा"],doNot:["किसी को कम मत आँको","तथ्य सही रखो"],sampleLines:'"मिर्ज़ाखानी ने 10वीं कक्षा में सोचा था वे गणित में अच्छी नहीं हैं — 2014 में Fields Medal मिला!"'},{no:19,type:"📊 प्रस्तुति",title:"फ्रैक्टल्स — अनंत में छुपा गणित",level:"कक्षा 7-9",duration:"8-10 मिनट",color:"from-indigo-400 to-violet-500",intro:"Fractals — वे आकृतियाँ जो हर स्तर पर अपने जैसी दिखती हैं। प्रकृति और गणित का अद्भुत मेल।",points:['आरंभ: "अगर तुम किनारे पर खड़े हो और ज़ूम करते जाओ — Fractal कभी खत्म नहीं होती!"',"","1. Fractal क्या है?","   — Self-similar आकृति: हर भाग, पूरे जैसा।","   — Benoit Mandelbrot ने 1975 में यह शब्द दिया।","","2. Mandelbrot Set:","   — z → z² + c का बार-बार प्रयोग।","   — जो अनंत नहीं जाता, वह Set में।","   — Zoom करते जाओ — हर बार नई सुंदरता!","","3. Sierpinski Triangle:","   — त्रिभुज → बीच काटो → 3 त्रिभुज → फिर काटो...।","   — कागज़ से बना सकते हो!","","4. प्रकृति में Fractals:","   — ब्रोकोली (Romanesco): Fractal spiral।","   — नदी के किनारे: Fractal boundary।","   — फेफड़े: Fractal branching — अधिकतम क्षेत्र।","   — बिजली: Fractal pattern।","","5. उपयोग:","   — Computer Graphics (Avatar, movies)।","   — Antenna design।","   — Medical imaging।","",'अंत: "अनंत सुंदरता — एक सरल गणितीय नियम से!"'],keyPoints:["Self-similarity","Mandelbrot","प्रकृति में","उपयोग"],doNot:["Computer Code मत दिखाओ","Visual चाहिए"],sampleLines:'"Mandelbrot ने कहा: God is a Fractal!"'},{no:20,type:"🎭 नाटक",title:"पाइथागोरस — एक अमर प्रमेय",level:"कक्षा 5-8",duration:"10-12 मिनट",color:"from-green-400 to-emerald-500",intro:"पाइथागोरस और उनके प्रमेय की खोज पर नाटक। 2500 साल पुरानी यह खोज आज भी ज़िंदा है।",points:["पात्र: पाइथागोरस, शिष्य 1, शिष्य 2, एक किसान, एक बच्चा (आधुनिक)","","दृश्य 1 — ग्रीस, 500 BCE:",'शिष्य 1: "गुरुजी, यह समकोण त्रिभुज की भुजाएं 3, 4, और 5 हैं।"','पाइथागोरस: (रेत पर वर्ग बनाते हैं) "देखो! 3² + 4² = 9 + 16 = 25 = 5²!"','शिष्य 2: "क्या यह हमेशा सच है?"','पाइथागोरस: "हाँ! हर समकोण त्रिभुज में — a² + b² = c²!"',"","दृश्य 2 — खेत में:",'किसान: "गुरुजी, मुझे सीधा कोण कैसे बनाऊं?"','पाइथागोरस: "3-4-5 की रस्सी लो! 3 हाथ, 4 हाथ, 5 हाथ — समकोण बन जाएगा!"','किसान: "वाह! इससे तो सीधी दीवार भी बना सकता हूँ!"',"","दृश्य 3 — आधुनिक कक्षा (Time Leap):",'बच्चा: "Sir, यह 2500 साल पुरानी प्रमेय आज भी काम आती है?"','Teacher: "हाँ! GPS, Architecture, Engineering, Robotics — सब में!"','"पाइथागोरस ने एक ऐसी नींव रखी जो कभी नहीं हिलेगी।"',"","अंत: a²+b²=c² — दो सेकंड की प्रमेय, अनंत उपयोग।"],keyPoints:["खोज की कहानी","व्यावहारिक उपयोग","आज भी प्रासंगिक","2500 साल"],doNot:["रटे हुए संवाद","भाव ज़रूरी है"],sampleLines:'"पाइथागोरस: यह नियम कभी नहीं बदलेगा — जब तक त्रिभुज है, a²+b²=c² है!"'}];function w7(){const[e,t]=v.useState(null),[n,s]=v.useState("सभी"),a=["सभी","🎤 भाषण","📖 कविता/निबंध","🎭 नाटक","📊 प्रस्तुति"],d=n==="सभी"?sy:sy.filter(l=>n==="📖 कविता/निबंध"?l.type.includes("कविता")||l.type.includes("निबंध"):l.type.includes(n.split(" ")[1]||n));return e?i.jsx(v7,{topic:e,onBack:()=>t(null)}):i.jsxs("div",{className:"max-w-4xl mx-auto px-4 py-8",children:[i.jsxs(_.div,{initial:{opacity:0,y:-20},animate:{opacity:1,y:0},className:"text-center mb-6",children:[i.jsx("h1",{className:"font-heading text-3xl md:text-4xl mb-2",children:"🎤 पत्रवाचन और भाषण"}),i.jsx("p",{className:"text-muted-foreground font-body mb-3",children:"20 विषय — पूरी स्क्रिप्ट, मुख्य बिंदु, क्या बोलें और क्या न बोलें!"}),i.jsxs("div",{className:"bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-2xl px-4 py-3 text-sm font-body text-blue-700 dark:text-blue-300 max-w-xl mx-auto",children:["💡 किसी भी विषय पर ",i.jsx("strong",{children:"क्लिक करें"})," — पूरी 10+ पेज की सामग्री मिलेगी!"]})]}),i.jsx("div",{className:"flex flex-wrap gap-2 justify-center mb-6",children:a.map(l=>i.jsx("button",{onClick:()=>s(l),className:`px-4 py-2 rounded-2xl font-body font-bold text-sm min-h-0 transition-all ${n===l?"bg-primary text-primary-foreground":"bg-card border hover:border-primary"}`,children:l},l))}),i.jsx("div",{className:"space-y-3",children:d.map((l,u)=>i.jsx(_.div,{initial:{opacity:0,x:-15},animate:{opacity:1,x:0},transition:{delay:u*.04},children:i.jsx("button",{onClick:()=>t(l),className:"w-full bg-card border rounded-2xl overflow-hidden shadow-sm hover:shadow-lg hover:border-primary transition-all text-left min-h-0",children:i.jsx("div",{className:"p-4",children:i.jsxs("div",{className:"flex items-center gap-3",children:[i.jsx("div",{className:`bg-gradient-to-r ${l.color} text-white rounded-xl w-12 h-12 flex items-center justify-center font-heading text-lg shrink-0`,children:l.no}),i.jsxs("div",{className:"flex-1 min-w-0",children:[i.jsxs("div",{className:"flex flex-wrap items-center gap-2 mb-0.5",children:[i.jsx("span",{className:"text-xs bg-muted px-2 py-0.5 rounded-full font-body font-bold",children:l.type}),i.jsx("span",{className:"text-xs text-muted-foreground font-body",children:l.level}),i.jsxs("span",{className:"text-xs text-muted-foreground font-body",children:["⏱ ",l.duration]})]}),i.jsx("h2",{className:"font-heading text-base md:text-lg text-foreground",children:l.title}),i.jsx("p",{className:"text-xs text-muted-foreground font-body mt-0.5 line-clamp-1",children:l.intro})]}),i.jsxs("div",{className:"flex items-center gap-1 shrink-0",children:[i.jsx("span",{className:"text-xs text-primary font-body font-bold hidden sm:block",children:"पूरी सामग्री"}),i.jsx(vc,{size:20,className:"text-primary"})]})]})})})},l.no))})]})}const j7=["98 × 97 = ?","15² = ?","एक आयत की लंबाई 8 cm और चौड़ाई 5 cm है। क्षेत्रफल और परिमाप निकालो।","½ + ¾ = ?","2x + 5 = 11, x का मान निकालो","त्रिभुज का क्षेत्रफल जिसका आधार 6 cm और ऊंचाई 4 cm है","√144 = ?","12 और 18 का LCM और HCF निकालो"];function N7(){return i.jsxs("div",{className:"flex flex-col items-center justify-center py-10 gap-4",children:[i.jsxs("div",{className:"relative",children:[[0,1,2,3,4,5].map(e=>i.jsx(_.div,{className:"absolute w-3 h-3 bg-primary rounded-full",style:{left:Math.cos(e/6*Math.PI*2)*30+30,top:Math.sin(e/6*Math.PI*2)*30+30},animate:{scale:[1,1.5,1],opacity:[.4,1,.4]},transition:{duration:1.2,delay:e*.2,repeat:1/0}},e)),i.jsx(_.div,{className:"w-16 h-16 flex items-center justify-center",animate:{rotate:360},transition:{duration:3,repeat:1/0,ease:"linear"},children:i.jsx(bc,{size:28,className:"text-primary"})})]}),i.jsx("p",{className:"font-body text-sm text-muted-foreground animate-pulse",children:"AI सोच रहा है... 🤔"})]})}function k7({step:e,index:t,total:n}){const s=t===n-1;return i.jsx(_.div,{initial:{opacity:0,y:20},animate:{opacity:1,y:0},transition:{delay:t*.15},className:`rounded-2xl p-4 border ${s?"bg-green-50 dark:bg-green-900/20 border-green-300 dark:border-green-700":"bg-card border-border"}`,children:i.jsxs("div",{className:"flex items-start gap-3",children:[i.jsx("div",{className:`shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold ${s?"bg-green-500 text-white":"bg-primary/10 text-primary"}`,children:s?"✓":t+1}),i.jsxs("div",{className:"flex-1 min-w-0",children:[e.label&&i.jsx("p",{className:"font-body text-xs text-muted-foreground mb-1 font-bold uppercase tracking-wide",children:e.label}),i.jsx("p",{className:`font-body text-sm leading-relaxed ${s?"font-bold text-green-700 dark:text-green-300 text-base":"text-foreground"}`,children:e.content}),e.formula&&i.jsxs("div",{className:"mt-2 bg-primary/5 border border-primary/20 rounded-xl px-3 py-2 font-body text-sm text-primary font-bold",children:["📐 ",e.formula]})]})]})})}function S7(){const[e,t]=v.useState(""),[n,s]=v.useState(!1),[a,d]=v.useState(null),l=v.useRef(null),u=async m=>{if(!m.trim())return;s(!0),d(null);const g=`तुम एक expert math teacher हो जो कक्षा 1-9 के students को पढ़ाते हो। 

इस सवाल को solve करो: "${m}"

Response को EXACTLY इस JSON format में दो:
